---
/** Purchase CTA: links to the live EasyOrders product page. */
import Icon from './Icon.astro';
import { orderHref } from '../../lib/content.js';

interface Props {
  class?: string;
  arrow?: boolean;
}

const { class: className = 'btn', arrow = true } = Astro.props;
---

<a href={orderHref} class={className} data-checkout>
  <slot />
  {arrow && <Icon name="arrow" class="btn-arrow" />}
</a>
