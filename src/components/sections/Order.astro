---
import { Image } from 'astro:assets';
import PalmFrond from '../ui/PalmFrond.astro';
import Icon from '../ui/Icon.astro';
import OrderLink from '../ui/OrderLink.astro';
import { travelBagImages } from '../../content/eloura-travel-bag.media.js';
import { content, hasCheckout, formatPrice } from '../../lib/content.js';

const { order, ctas, product, packageContents } = content;
const price = formatPrice();
const thumb = travelBagImages.orderThumb;
---

<section id="order" class="section overflow-hidden" aria-labelledby="order-title">
  <PalmFrond class="decor-frond -right-28 -bottom-24 w-[24rem] rotate-[8deg] -scale-x-100 sm:w-[30rem]" />
  <PalmFrond class="decor-frond -top-10 -left-36 w-[30rem] rotate-[200deg] -scale-x-100 max-md:hidden" />

  <div class="container-x relative">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{order.eyebrow}</p>
        <h2 id="order-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">{order.heading}</h2>
        <p class="lead mt-7" data-reveal style="--reveal-delay:140">{order.description}</p>
      </div>
      {
        price && (
          <div class="lg:col-span-5 lg:justify-self-end" data-reveal style="--reveal-delay:180">
            <p class="label">{order.priceLabel}</p>
            <p class="mt-3 font-display text-[clamp(1.75rem,1.4rem+1.2vw,2.5rem)] leading-none text-champagne-300">{price}</p>
          </div>
        )
      }
    </div>

    <div
      class="mt-16 rounded-[2rem] border border-champagne-300/20 bg-night-900/70 p-6 backdrop-blur-sm sm:p-10 lg:mt-20 lg:rounded-[2.75rem] lg:p-14"
      data-reveal="fade"
    >
      <div class="grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-14">
        <div class="shape-circle hover-zoom relative mx-auto w-44 border border-champagne-300/30 sm:w-56">
          <Image src={thumb.src} alt={thumb.alt} widths={[240, 360, 480]} sizes="(min-width: 40rem) 14rem, 11rem" quality={62} class="media-fill" />
        </div>
        <div>
          <p class="font-display text-[clamp(1.5rem,1.2rem+1vw,2.125rem)] leading-snug text-champagne-300">{product.name}</p>
          <p class="meta mt-1"><span lang="en" dir="ltr">{product.nameEn}</span></p>
          <p class="label mt-8 text-champagne-500">{order.contentsTitle}</p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-3">
            {
              packageContents.map((item: string) => (
                <li class="flex gap-2.5 text-[0.95rem] text-champagne-100">
                  <Icon name="check" class="mt-1 size-4 shrink-0 text-champagne-500" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="hairline mt-12 flex flex-col gap-6 border-t pt-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl space-y-2">
          <p class="text-sm text-mist-300">{hasCheckout ? order.checkoutNote : order.unavailableNote}</p>
          {
            !hasCheckout && import.meta.env.DEV && (
              <p class="source-note" lang="en" dir="ltr">
                Dev note: set <code>commerce.checkoutUrl</code> in src/content/eloura-travel-bag.content.js to enable ordering.
              </p>
            )
          }
        </div>
        {
          hasCheckout ? (
            <OrderLink class="btn btn-solid shrink-0">{ctas.order}</OrderLink>
          ) : (
            <span class="btn shrink-0" role="link" aria-disabled="true">
              {ctas.unavailable}
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>
