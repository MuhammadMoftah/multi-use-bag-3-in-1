---
import Icon from '../ui/Icon.astro';
import Wordmark from '../ui/Wordmark.astro';
import { content } from '../../lib/content.js';

const { brand, product, store } = content;
---

<section id="brand" class="section section-tint" aria-labelledby="brand-title">
  <div class="container-x grid items-center gap-14 lg:grid-cols-12">
    <div class="flex justify-center lg:col-span-5" data-reveal="scale">
      <div class="relative flex aspect-square w-[min(100%,15rem)] items-center justify-center rounded-full border border-champagne-300/25 sm:w-[min(100%,22rem)]">
        <span class="absolute inset-4 rounded-full border border-champagne-300/10" aria-hidden="true"></span>
        <Wordmark size="lg" class="relative" />
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <p class="eyebrow" data-reveal>{brand.eyebrow}</p>
      <h2 id="brand-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">
        {brand.heading}
        <span class="italic-accent mt-4 block">{brand.accent}</span>
      </h2>
      <p class="lead mt-8" data-reveal style="--reveal-delay:140">{brand.description}</p>
      <dl class="hairline mt-10 grid gap-6 border-t pt-8 sm:grid-cols-2" data-reveal style="--reveal-delay:180">
        <div>
          <dt class="label">المنتج</dt>
          <dd class="mt-2 font-display text-2xl text-champagne-100">{product.name}</dd>
          <dd class="meta mt-1"><span lang="en" dir="ltr">{product.nameEn}</span></dd>
        </div>
        <div>
          <dt class="label">المتجر</dt>
          <dd class="mt-2">
            {
              store.url ? (
                <a href={store.url} class="text-link inline-flex items-center gap-2 text-[0.95rem]" target="_blank" rel="noopener">
                  <span lang="en">{store.name}</span>
                  <Icon name="external" class="size-4" />
                  <span class="sr-only">(بيفتح في تاب جديدة)</span>
                </a>
              ) : (
                <span class="font-display text-2xl text-champagne-100" lang="en">
                  {store.name}
                </span>
              )
            }
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
