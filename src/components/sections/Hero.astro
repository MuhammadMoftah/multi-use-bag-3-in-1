---
import { Picture } from 'astro:assets';
import OrderLink from '../ui/OrderLink.astro';
import { tshirtImages } from '../../content/eloura-oversized-tshirt.media.js';
import { content } from '../../lib/content.js';

const { hero, ctas } = content;
const image = tshirtImages.hero;
---

<section id="top" class="relative isolate overflow-hidden lg:min-h-[min(100svh,58rem)]" aria-labelledby="hero-title">
  <div class="relative h-[min(64svh,34rem)] w-full overflow-hidden sm:h-[min(70svh,42rem)] lg:absolute lg:end-0 lg:top-0 lg:h-full lg:w-[54%]">
    <Picture
      src={image.src}
      alt={image.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1080, 1254]}
      sizes="(min-width: 64rem) 54vw, 100vw"
      quality={50}
      priority
      class="media-fill animate-unveil object-[48%_0%] lg:object-[50%_20%]"
      pictureAttributes={{ class: 'contents' }}
    />
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-ink-900/85 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink-900 to-transparent lg:hidden" aria-hidden="true"></div>
    <div class="absolute inset-y-0 start-0 hidden w-2/5 bg-gradient-to-l from-ink-900 to-transparent lg:block" aria-hidden="true"></div>
  </div>

  <span class="backdrop-word -bottom-8 start-[-1%] hidden text-[15rem] lg:block" aria-hidden="true" lang="en">OVERSIZED</span>

  <div class="container-x relative pb-20 lg:flex lg:min-h-[min(100svh,58rem)] lg:items-center lg:pt-40 lg:pb-24">
    <div class="-mt-24 max-w-xl animate-settle sm:-mt-32 lg:mt-0 lg:w-[44%] lg:max-w-none">
      <p class="eyebrow" lang="en">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display-1 mt-6 text-[clamp(2.6rem,1.6rem+3.6vw,5rem)]">
        {hero.heading}
        <span class="heading-accent mt-4 block text-bone-300">{hero.subheading}</span>
      </h1>
      <p class="lead mt-6 max-w-[30rem]">{hero.description}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
        <OrderLink class="btn btn-solid min-h-13 px-9">{ctas.primary}</OrderLink>
        <a href="#product" class="link-underline pb-1 text-[0.9375rem] font-semibold text-bone-100">
          {ctas.explore}
        </a>
      </div>
      <dl class="hairline mt-12 grid grid-cols-3 gap-4 border-t pt-6 sm:gap-8">
        {
          hero.highlights.map((item: any) => (
            <div>
              <dt class="meta">{item.label}</dt>
              <dd class="mt-1 text-[0.95rem] font-bold text-bone-100 sm:text-base">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
