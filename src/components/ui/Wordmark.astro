---
/** Typographic Eloura wordmark (no official logo file has been supplied). */
import { content } from '../../lib/content.js';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
const sizes = {
  sm: 'text-[1.45rem]',
  md: 'text-[1.85rem]',
  lg: 'text-[2.5rem]',
};
---

<span class:list={['inline-flex flex-col items-center leading-none', className]} lang="en" dir="ltr">
  <span class:list={['font-brand whitespace-nowrap text-bone-100 italic', sizes[size]]}>{content.store.name}</span>{' '}
  <span class="mt-1 text-[0.55rem] font-semibold tracking-[0.42em] whitespace-nowrap text-bone-500 uppercase">{content.store.tagline}</span>
</span>
