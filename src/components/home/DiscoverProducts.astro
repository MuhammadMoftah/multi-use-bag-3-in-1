---
/**
 * The collection, straight from the registry. One product gets a side-by-side
 * feature card; several get an editorial grid whose middle column sits lower.
 * A closing row points to the official store for the full catalogue.
 */
import ProductCard from '../showcase/ProductCard.astro';
import Icon from '../ui/Icon.astro';
import { home } from '../../data/home';
import { store } from '../../data/site';
import { products } from '../../products';

const { products: copy } = home;
const single = products.length === 1;
const count = String(products.length).padStart(2, '0');
---

<section id="products" class="section section-tint" aria-labelledby="products-title">
  <div class="container-x">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
        <h2 id="products-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">{copy.title}</h2>
      </div>
      <div class="lg:col-span-5 lg:pb-2" data-reveal style="--reveal-delay:140">
        <p class="lead">{copy.description}</p>
        <p class="mt-5 flex items-baseline gap-3">
          <span class="font-display text-[1.75rem] leading-none font-extrabold text-bone-100" lang="en">{count}</span>
          <span class="meta">{copy.countLabel}</span>
        </p>
      </div>
    </div>

    {
      single ? (
        <div class="mt-12 lg:mt-16">
          <ProductCard product={products[0]} index={0} cta={copy.cta} variant="feature" />
        </div>
      ) : (
        <ul class="collection-grid mt-12 grid gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-8">
          {products.map((product, index) => (
            <li>
              <ProductCard product={product} index={index} cta={copy.cta} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="hairline mt-12 flex flex-col gap-5 border-t pt-8 sm:flex-row sm:items-center sm:justify-between lg:mt-16" data-reveal>
      <p class="meta text-[0.9375rem]">{copy.storeNote}</p>
      <a href={store.url} class="group inline-flex shrink-0 items-center gap-3 text-[0.9375rem] font-bold text-bone-100" data-track="store">
        <span class="link-underline pb-0.5">{copy.storeCta}</span>
        <span class="btn-round size-10 group-hover:border-bone-100 group-hover:bg-bone-100 group-hover:text-ink-900">
          <Icon name="arrow" class="btn-arrow" />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @media (width >= 64rem) {
    .collection-grid > li:nth-child(3n + 2) {
      margin-top: 4rem;
    }
  }
</style>
