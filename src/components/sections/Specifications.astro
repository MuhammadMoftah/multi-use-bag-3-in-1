---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import OrderLink from '../ui/OrderLink.astro';
import { content, formatPrice } from '../../lib/content.js';

const { specs, colors, packageContents, care, ctas, order } = content;
const price = formatPrice();
const bar = price ? [...specs.bar, { label: order.priceLabel, value: price }] : specs.bar;
---

<section id="specs" class="section" aria-labelledby="specs-title">
  <div class="container-x">
    <SectionHeading id="specs-title" eyebrow={specs.eyebrow} title={specs.title} accent={specs.accent} align="center" class="max-w-3xl" />

    <dl class="pill-bar mx-auto mt-14 max-w-5xl" data-reveal>
      {
        bar.map((item: any) => (
          <div>
            <dt class="label">{item.label}</dt>
            <dd class="font-display text-[clamp(1.375rem,1.1rem+1vw,2rem)] leading-none font-extrabold whitespace-nowrap text-bone-100">
              {item.lang ? <span lang={item.lang} dir="ltr">{item.value}</span> : item.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-2">
      <div id="colors" class="frame scroll-mt-24 p-7 sm:p-9" data-reveal>
        <h3 class="heading-3">{specs.colorsTitle}</h3>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-5">
          {
            colors.map((color: any) => (
              <li class="flex flex-col items-center gap-2.5">
                <span class="swatch" style={`background:${color.hex}`} aria-hidden="true" />
                <span class="text-[0.875rem] text-bone-100">{color.name}</span>
              </li>
            ))
          }
        </ul>
        <p class="source-note mt-6">{specs.colorsNote}</p>
      </div>

      <div class="frame p-7 sm:p-9" data-reveal style="--reveal-delay:100">
        <h3 class="heading-3">{specs.sizeTitle}</h3>
        <p class="mt-5 flex items-baseline gap-3">
          <span class="font-display text-[2.75rem] leading-none font-extrabold text-bone-100" lang="en" dir="ltr">{content.product.featuredSize}</span>
          <span class="meta">{content.product.fit}</span>
        </p>
        <p class="mt-5 text-[0.95rem] text-mist-300">{specs.sizeText}</p>
      </div>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl gap-12 md:grid-cols-2 md:gap-10">
      <div data-reveal>
        <h3 class="heading-3">{specs.careTitle}</h3>
        <ul class="mt-5 space-y-3">
          {
            care.map((line: string) => (
              <li class="flex gap-3 text-[0.95rem] text-mist-300">
                <Icon name="check" class="mt-1.5 size-4 shrink-0 text-bone-500" />
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal style="--reveal-delay:100">
        <h3 class="heading-3">{specs.contentsTitle}</h3>
        <ul class="mt-5 space-y-3">
          {
            packageContents.map((item: string) => (
              <li class="flex items-center gap-3 text-[0.95rem] text-bone-100">
                <Icon name="shirt" class="size-5 shrink-0 text-bone-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <details class="group hairline mx-auto mt-16 max-w-5xl border-y" data-reveal>
      <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-5 text-start [&::-webkit-details-marker]:hidden">
        <span>
          <span class="block font-display text-xl font-bold text-bone-100 sm:text-2xl">{specs.tableTitle}</span>
          <span class="meta mt-1 block">{specs.table.length} بنود</span>
        </span>
        <span class="btn-round size-10 shrink-0">
          <Icon name="plus" class="size-4 transition-transform duration-500 group-open:rotate-45" />
        </span>
      </summary>
      <div class="overflow-x-auto pb-6">
        <table class="w-full text-start text-sm">
          <caption class="sr-only">{specs.tableTitle}</caption>
          <tbody>
            {
              specs.table.map((row: any) => (
                <tr class="border-b border-white/5">
                  <th scope="row" class="py-3 pe-6 text-start font-normal text-mist-400">{row.label}</th>
                  <td class="py-3 text-end text-bone-100">
                    {row.lang ? <span lang={row.lang} dir="ltr">{row.value}</span> : row.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <div class="mx-auto mt-12 flex max-w-5xl flex-col gap-8 md:flex-row md:items-center md:justify-between" data-reveal>
      <p class="source-note max-w-2xl">{specs.disclaimer}</p>
      <OrderLink class="btn shrink-0">{ctas.primary}</OrderLink>
    </div>
  </div>
</section>
