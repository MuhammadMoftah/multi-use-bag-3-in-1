---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';
import type { Product } from '../products';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  ogType?: 'website' | 'product';
  ogImage?: string;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown>;
  /** Set on product landing pages: enables the product view analytics event. */
  product?: Product;
}

const { title, description, keywords = [], ogType = 'website', ogImage, ogImageAlt, structuredData, product } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = Astro.site && ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join('، ')} />}
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-plex-arabic" preload={[{ weight: '700', style: 'normal' }, { weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-manrope" />
    <Font cssVariable="--font-cormorant" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <Analytics product={product} />
  </head>
  <body>
    <Analytics placement="body" />
    <a
      href="#main"
      class="fixed start-3 top-3 z-[70] -translate-y-24 rounded-full bg-bone-100 px-5 py-3 text-sm font-semibold text-ink-900 transition-transform focus:translate-y-0"
    >
      تخطي إلى المحتوى
    </a>
    <slot />
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initTracking } from '../scripts/tracking';
      initReveal();
      initTracking();
    </script>
  </body>
</html>
