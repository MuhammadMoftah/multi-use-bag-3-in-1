---
import { Image } from 'astro:assets';
import { tshirtImages } from '../../content/eloura-oversized-tshirt.media.js';
import { content, pad2 } from '../../lib/content.js';

const { material } = content;
const main = tshirtImages.materialMain;
const detail = tshirtImages.materialDetail;
---

<section id="material" class="section overflow-hidden" aria-labelledby="material-title">
  <div class="container-x grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
    <div class="relative lg:col-span-6">
      <div class="frame hover-zoom aspect-[430/334]" data-reveal="image">
        <Image src={main.src} alt={main.alt} widths={[430]} sizes="(min-width: 64rem) 36rem, 100vw" quality={72} class="media-fill" />
      </div>
      <div
        class="frame hover-zoom absolute -bottom-10 end-4 w-[38%] border-[6px] border-ink-900 sm:end-8 aspect-square"
        data-reveal="scale"
        style="--reveal-delay:200"
      >
        <Image
          src={detail.src}
          alt={detail.alt}
          widths={[240, 360, 480]}
          sizes="(min-width: 64rem) 14rem, 38vw"
          quality={62}
          class="media-fill"
          style={detail.position ? `object-position:${detail.position}` : undefined}
        />
      </div>
    </div>

    <div class="pt-8 lg:col-span-6 lg:pt-0">
      <p class="eyebrow" data-reveal>{material.eyebrow}</p>
      <h2 id="material-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">
        {material.heading}
        <span class="heading-accent mt-4 block">{material.accent}</span>
      </h2>
      <p class="lead mt-7" data-reveal style="--reveal-delay:140">{material.description}</p>

      <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-3">
        {
          material.points.map((point: any, index: number) => (
            <li class="hairline border-t pt-5" data-reveal style={`--reveal-delay:${160 + index * 80}`}>
              <span class="label text-bone-500" aria-hidden="true" lang="en">{pad2(index)}</span>
              <h3 class="mt-3 text-[1.0625rem] font-bold text-bone-100">{point.title}</h3>
              <p class="meta mt-2 text-[0.875rem]">{point.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
