---
/**
 * Tracking tags, configured in `analytics` (src/content/eloura-travel-bag.content.js).
 * Render once in <head> and once at the top of <body> (`placement="body"`, the
 * Meta Pixel <noscript> image, which is not valid inside <head>).
 *
 * Meta Pixel: official base code only (init + PageView), deferred until after
 * the window load event. The page is a single static document without
 * client-side routing, so PageView fires once per page load; the
 * `if(f.fbq)return` guard prevents a second bootstrap. ViewContent,
 * InitiateCheckout and Purchase are intentionally not sent from this site yet:
 * they will be set up together with EasyOrders' own Pixel integration. Never
 * send Purchase on a CTA click; orders are created on EasyOrders.
 *
 * GA4 (inactive while `ga4MeasurementId` is null): page view, view_item, and
 * begin_checkout on the first click of a `data-checkout` link.
 */
import { content } from '../lib/content.js';

interface Props {
  placement?: 'head' | 'body';
}

const { placement = 'head' } = Astro.props;
const { analytics, commerce, product } = content;

const pixelId = analytics.metaPixelId;
if (pixelId !== null && !/^\d+$/.test(pixelId)) {
  throw new Error(`analytics.metaPixelId must be a numeric string, got "${pixelId}"`);
}

// Official base code, unchanged, run after the page has loaded (and the main
// thread is idle) so the third-party script doesn't compete with the hero/LCP.
const metaPixelBootstrap = `
(function () {
function elouraMetaPixel() {
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${pixelId}');
fbq('track', 'PageView');
}
function schedule() {
  if ('requestIdleCallback' in window) requestIdleCallback(elouraMetaPixel, { timeout: 3000 });
  else setTimeout(elouraMetaPixel, 1);
}
if (document.readyState === 'complete') schedule();
else window.addEventListener('load', schedule, { once: true });
})();
`;

const ga4Id = analytics.ga4MeasurementId;
const productInfo = {
  name: product.nameEn,
  id: product.slug,
  currency: commerce.currency,
  value: typeof commerce.price === 'number' ? commerce.price : null,
};
---

{
  placement === 'head' && pixelId && (
    <Fragment>
      <!-- Meta Pixel Code -->
      <script is:inline set:html={metaPixelBootstrap} />
      <!-- End Meta Pixel Code -->
    </Fragment>
  )
}
{
  placement === 'body' && pixelId && (
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`} />
    </noscript>
  )
}
{
  placement === 'head' && ga4Id && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id, productInfo }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', ga4Id);
        var item = { currency: productInfo.currency, items: [{ item_id: productInfo.id, item_name: productInfo.name }] };
        if (productInfo.value !== null) { item.value = productInfo.value; item.items[0].price = productInfo.value; }
        gtag('event', 'view_item', item);
        var checkoutTracked = false;
        document.addEventListener('click', function (event) {
          if (checkoutTracked || !event.target.closest || !event.target.closest('a[data-checkout]')) return;
          checkoutTracked = true;
          gtag('event', 'begin_checkout', item);
        });
      </script>
    </Fragment>
  )
}
