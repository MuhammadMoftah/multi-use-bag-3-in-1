---
import { Image } from 'astro:assets';
import Icon from '../../../components/ui/Icon.astro';
import OrderLink from '../../../components/ui/OrderLink.astro';
import entry from '../product';
import { tshirtImages } from '../media.js';
import { content, formatPrice } from '../lib.js';

const { order, ctas, product, colors, packageContents } = content;
const price = formatPrice();
const thumb = tshirtImages.orderThumb;
---

<section id="order" class="section overflow-hidden" aria-labelledby="order-title">
  <span class="backdrop-word -bottom-10 start-1/2 translate-x-1/2 text-[clamp(8rem,22vw,20rem)]" aria-hidden="true" lang="en">ELOURA</span>

  <div class="container-x relative">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{order.eyebrow}</p>
        <h2 id="order-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">{order.heading}</h2>
        <p class="lead mt-7" data-reveal style="--reveal-delay:140">{order.description}</p>
      </div>
      {
        price && (
          <div class="lg:col-span-5 lg:justify-self-end" data-reveal style="--reveal-delay:180">
            <p class="label">{order.priceLabel}</p>
            <p class="mt-3 font-display text-[clamp(1.75rem,1.4rem+1.2vw,2.5rem)] leading-none font-extrabold text-bone-100">{price}</p>
          </div>
        )
      }
    </div>

    <div class="mt-14 rounded-[2rem] border border-white/10 bg-ink-850/80 p-6 backdrop-blur-sm sm:p-10 lg:mt-16 lg:rounded-[2.5rem] lg:p-14" data-reveal="fade">
      <div class="grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-14">
        <div class="frame hover-zoom relative mx-auto aspect-[826/861] w-48 sm:w-60">
          <Image src={thumb.src} alt={thumb.alt} widths={[240, 360, 480]} sizes="(min-width: 40rem) 15rem, 12rem" quality={64} class="media-fill" />
        </div>
        <div>
          <p class="font-display text-[clamp(1.5rem,1.2rem+1vw,2.125rem)] leading-snug font-bold text-bone-100">{product.name}</p>
          <p class="meta mt-1"><span lang="en" dir="ltr">{product.nameEn}</span></p>

          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            <div>
              <p class="label text-bone-500">{order.colorsTitle}</p>
              <ul class="mt-4 flex flex-wrap gap-3">
                {
                  colors.map((color: any) => (
                    <li>
                      <span class="swatch size-7" style={`background:${color.hex}`} title={color.name} aria-hidden="true" />
                      <span class="sr-only">{color.name}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p class="label text-bone-500">{order.contentsTitle}</p>
              <ul class="mt-4 space-y-2">
                {
                  packageContents.map((item: string) => (
                    <li class="flex gap-2.5 text-[0.95rem] text-bone-100">
                      <Icon name="check" class="mt-1 size-4 shrink-0 text-bone-500" />
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="hairline mt-12 flex flex-col gap-6 border-t pt-8 md:flex-row md:items-center md:justify-between">
        <p class="max-w-xl text-sm text-mist-300">{order.checkoutNote}</p>
        <OrderLink product={entry} class="btn btn-solid shrink-0">{ctas.order}</OrderLink>
      </div>
    </div>
  </div>
</section>
