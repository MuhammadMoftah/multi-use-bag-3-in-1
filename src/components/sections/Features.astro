---
import { Image } from 'astro:assets';
import { travelBagImages } from '../../content/eloura-travel-bag.media.js';
import { content, pad2 } from '../../lib/content.js';

const { features, useCases } = content;
const { lifestyle } = features;
const main = travelBagImages.featuresMain;
const inset = travelBagImages.interior;
---

<section id="features" class="section overflow-hidden" aria-labelledby="features-title">
  <div class="grid items-start gap-y-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
    <div class="container-x lg:me-0 lg:max-w-[42rem] lg:pe-12">
      <p class="eyebrow" data-reveal>{features.eyebrow}</p>
      <h2 id="features-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">
        {features.heading}
      </h2>
      <p class="lead mt-8" data-reveal style="--reveal-delay:140">{features.description}</p>

      <ol class="mt-12 grid gap-x-10 sm:grid-cols-2" data-reveal style="--reveal-delay:180">
        {
          features.items.map((feature: any, index: number) => (
            <li class="hairline flex items-baseline gap-4 border-b py-4">
              <span class="w-6 shrink-0 font-display text-[0.95rem] text-champagne-500 tabular-nums">{pad2(index)}</span>
              <span>
                <span class="block text-[0.95rem] font-medium text-champagne-100">{feature.title}</span>
                <span class="meta mt-1 block">{feature.description}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="relative ps-6 pb-[24%] sm:ps-16 lg:mt-24 lg:ps-4 lg:pb-[20%]">
      <div class="shape-pebble hover-zoom relative ms-auto aspect-[5/6] w-[90%] overflow-hidden" data-reveal="image">
        <Image
          src={main.src}
          alt={main.alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 64rem) 44vw, 90vw"
          quality={62}
          class="media-fill"
          style={main.position ? `object-position:${main.position}` : undefined}
        />
      </div>
      <div class="shape-circle hover-zoom absolute start-[4%] bottom-0 w-[46%] border-[6px] border-night-900 sm:start-[10%] lg:start-0" data-reveal="scale" style="--reveal-delay:200">
        <Image
          src={inset.src}
          alt={inset.alt}
          widths={[360, 560, 720]}
          sizes="(min-width: 64rem) 20vw, 44vw"
          quality={62}
          class="media-fill"
          style={inset.position ? `object-position:${inset.position}` : undefined}
        />
      </div>
    </div>
  </div>

  <div class="container-x mt-20 lg:mt-24">
    <div class="hairline grid gap-8 border-t pt-10 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-4">
        <h3 class="heading-3">{features.useCasesTitle}</h3>
        <p class="source-note mt-3 max-w-xs">{features.useCasesNote}</p>
      </div>
      <ul class="flex flex-wrap content-start gap-2 lg:col-span-8">
        {useCases.map((item: string) => <li class="tag">{item}</li>)}
      </ul>
    </div>
  </div>

  <div id="lifestyle" class="container-x mt-24 scroll-mt-24 lg:mt-32" aria-labelledby="lifestyle-title">
    <div class="relative overflow-hidden rounded-[2rem] border border-champagne-300/20 bg-night-850 px-6 py-14 sm:px-12 lg:rounded-[3rem] lg:px-20 lg:py-16">
      <span
        class="pointer-events-none absolute -end-6 -top-10 font-display text-[11rem] leading-none text-champagne-300/[0.05] italic select-none sm:text-[15rem]"
        aria-hidden="true"
        lang="en"
      >
        Eloura
      </span>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6" data-reveal>
          <p class="eyebrow" lang="en">{lifestyle.eyebrow}</p>
          <h3 id="lifestyle-title" class="heading-3 mt-5 text-[clamp(1.75rem,1.3rem+1.5vw,2.625rem)]">{lifestyle.heading}</h3>
          <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-mist-300">{lifestyle.description}</p>
        </div>
        <div class="lg:col-span-6" data-reveal style="--reveal-delay:120">
          <ul class="flex flex-wrap gap-2 lg:justify-end">
            {lifestyle.highlights.map((item: string) => <li class="tag border-champagne-300/35 text-champagne-100">{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
