---
/**
 * Purchase CTA: links (same tab) to the product's official EasyOrders page.
 * `data-track="checkout"` feeds the click tracking in `src/scripts/tracking.ts`.
 */
import Icon from './Icon.astro';
import type { Product } from '../../products';

interface Props {
  product: Pick<Product, 'id' | 'nameEn' | 'purchaseUrl'>;
  class?: string;
  arrow?: boolean;
}

const { product, class: className = 'btn', arrow = true } = Astro.props;
---

<a href={product.purchaseUrl} class={className} data-track="checkout" data-product-id={product.id} data-product-name={product.nameEn}>
  <slot />
  {arrow && <Icon name="arrow" class="btn-arrow" />}
</a>
