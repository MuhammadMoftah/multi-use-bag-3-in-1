---
import Wordmark from './ui/Wordmark.astro';
import { content } from '../lib/content.js';
import type { NavItem } from './SiteHeader.astro';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const { store, product, footer } = content;
const storeLinks = footer.links
  .map((link: any) => ({ label: link.label, href: (store as Record<string, string | null>)[link.key] }))
  .filter((link: any) => link.href);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-champagne-300/15 bg-night-950/40">
  <div class="container-x py-16 text-center lg:py-20">
    <a href="#top" class="inline-block" aria-label={`${store.name} Travel Essentials — الرجوع لأول الصفحة`}>
      <Wordmark size="lg" />
    </a>

    <nav aria-label="روابط الفوتر" class="mt-10">
      <ul class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
        {
          [...items, { href: '#order', label: 'اطلبي' }].map((item) => (
            <li>
              <a href={item.href} class="link-underline inline-flex min-h-11 items-center px-3 text-[0.875rem] text-mist-200 hover:text-champagne-100">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mt-8 text-sm text-mist-300">
      {product.name} <span class="text-mist-400" aria-hidden="true">·</span> <span lang="en" dir="ltr">{product.nameEn}</span>
    </p>

    <div class="hairline mx-auto mt-12 max-w-4xl border-t pt-8">
      {
        storeLinks.length > 0 && (
          <ul class="mb-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
            {storeLinks.map((link: any) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener" class="text-mist-300 underline decoration-mist-400/40 underline-offset-4 hover:text-champagne-100">
                  {link.label}
                  <span class="sr-only"> (بيفتح في تاب جديدة)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="source-note mx-auto max-w-3xl">{footer.note}</p>
      <p class="source-note mt-4" dir="ltr">© {year} {store.name}</p>
    </div>
  </div>
</footer>
